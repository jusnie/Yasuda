# Optional default Open WebUI instance. Leave blank to have users enter their own server URL.
EXPO_PUBLIC_OPEN_WEBUI_URL=

# Vertis branding / native identifiers. Choose a unique application ID before publishing.
EXPO_PUBLIC_APP_NAME=Vertis
EXPO_PUBLIC_APP_SLUG=vertis
EXPO_PUBLIC_APP_SCHEME=vertis
EXPO_PUBLIC_APP_ID=com.yasuda.vertis

# Set these after creating an Expo/EAS project and app-store listings.
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_APP_OWNER=
EXPO_PUBLIC_IOS_APP_STORE_ID=
EXPO_PUBLIC_PLAY_STORE_APP_ID=

# Optional integrations. Leave blank to keep crash reporting/feedback backend disabled.
SENTRY_DSN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
